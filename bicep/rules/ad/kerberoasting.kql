// T1558.003
let W = union isfuzzy=true
    (SecurityEvent
     | where TimeGenerated > ago(15m) and EventID in (4769)
     | project TimeGenerated, Computer, EventID, Raw=tostring(EventData), M=pack_all()),
    (Event
     | where TimeGenerated > ago(15m) and EventLog =~ 'Security' and EventID in (4769)
     | project TimeGenerated, Computer, EventID, Raw=tostring(EventData), M=pack_all());
W
| extend
    TargetUserName=coalesce(tostring(M.TargetUserName), extract(@'<Data Name="TargetUserName">([^<]*)', 1, Raw)),
    IpAddress=coalesce(tostring(M.IpAddress), tostring(M.ClientAddress), extract(@'<Data Name="IpAddress">([^<]*)', 1, Raw), extract(@'<Data Name="ClientAddress">([^<]*)', 1, Raw)),
    Encryption=coalesce(tostring(M.TicketEncryptionType), extract(@'<Data Name="TicketEncryptionType">([^<]*)', 1, Raw)),
    Service=coalesce(tostring(M.ServiceName), extract(@'<Data Name="ServiceName">([^<]*)', 1, Raw)),
    Status=coalesce(tostring(M.Status), extract(@'<Data Name="Status">([^<]*)', 1, Raw))
| where isempty(Status) or Status in~ ('0x0','0')
| where isnotempty(Service) and Service !endswith '$' and Service !~ 'krbtgt'
| where isnotempty(TargetUserName) and TargetUserName !endswith '$'
| summarize Tickets=count(), RC4Tickets=countif(Encryption =~ '0x17'), UniqueServices=dcount(Service),
            Services=make_set(Service,30), TimeGenerated=max(TimeGenerated)
    by Computer, SrcIP=IpAddress, TargetUserName
| where (RC4Tickets >= 3) or (Tickets >= 8 and UniqueServices >= 4)
