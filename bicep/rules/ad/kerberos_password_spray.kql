// T1110.003
let W = union isfuzzy=true
    (SecurityEvent
     | where TimeGenerated > ago(15m) and EventID in (4771)
     | project TimeGenerated, Computer, EventID, Raw=tostring(EventData), M=pack_all()),
    (Event
     | where TimeGenerated > ago(15m) and EventLog =~ 'Security' and EventID in (4771)
     | project TimeGenerated, Computer, EventID, Raw=tostring(EventData), M=pack_all());
W
| extend
    TargetUserName=coalesce(tostring(M.TargetUserName), extract(@'<Data Name="TargetUserName">([^<]*)', 1, Raw)),
    IpAddress=coalesce(tostring(M.IpAddress), tostring(M.ClientAddress), extract(@'<Data Name="IpAddress">([^<]*)', 1, Raw), extract(@'<Data Name="ClientAddress">([^<]*)', 1, Raw)),
    Status=coalesce(tostring(M.Status), extract(@'<Data Name="Status">([^<]*)', 1, Raw))
| extend FailureCode=coalesce(Status, extract(@'<Data Name="FailureCode">([^<]*)',1,Raw))
| where FailureCode =~ '0x18' and isnotempty(IpAddress)
| where TargetUserName !endswith '$' and isnotempty(TargetUserName)
| summarize Attempts=count(), Accounts=dcount(TargetUserName), Names=make_set(TargetUserName,25), TimeGenerated=max(TimeGenerated)
    by Computer, SourceIP=IpAddress
| where Accounts >= 5 and Attempts >= 5
