// T1110.003
SigninLogs
| where TimeGenerated > ago(15m)
| where ResultType in ('50126','50053','50055')
| where isnotempty(IPAddress) and isnotempty(UserPrincipalName)
| summarize Attempts=count(), Users=dcount(UserPrincipalName), Accounts=make_set(UserPrincipalName,20),
            TimeGenerated=max(TimeGenerated) by IPAddress
| where Users >= 5 and Attempts >= 10
