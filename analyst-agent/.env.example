# ONZE Sentinel SOC Toolkit - example configuration
# Copy to .env locally. NEVER commit populated .env files.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=Secure-Landing-Zone-Monitor
AZURE_WORKSPACE_NAME=azure-log-analytics
AZURE_WORKSPACE_ID=
AZURE_TENANT_ID=
AZURE_AUTH_MODE=cli

# Local llama.cpp / OpenAI-compatible server
LLM_URL=http://127.0.0.1:8081/v1
LLM_MODEL=
LLM_CONTEXT_TOKENS=32768
LLM_OUTPUT_TOKENS=2048

# Query, investigation and polling limits
QUERY_MAX_HOURS=720
QUERY_MAX_ROWS=150
QUERY_TIMEOUT_SECONDS=50
POLL_SECONDS=60
MAX_ROUNDS=20
MAX_TOOL_CALLS=50
MAX_INVESTIGATION_SECONDS=900
CORRELATION_QUERIES=4

# Mutations and alerts disabled unless intentionally configured
ENABLE_CASE_WRITES=false
CREATE_REVIEW_TASK=false
MARK_ACTIVE_ON_ESCALATION=false
ESCALATION_WEBHOOK_URL=
AUDIT_DIR=audit
