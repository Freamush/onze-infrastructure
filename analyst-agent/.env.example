# azure workspace
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=
AZURE_WORKSPACE_ID=
AZURE_TENANT_ID=
AZURE_AUTH_MODE=cli

# local OpenAI-compatible server
LLM_URL=http://127.0.0.1:8080/v1
LLM_MODEL=

# tool budgets and incident polling
QUERY_MAX_HOURS=720
QUERY_MAX_ROWS=150
QUERY_TIMEOUT_SECONDS=50
POLL_SECONDS=60
MAX_ROUNDS=14
MAX_TOOL_CALLS=35
MAX_INVESTIGATION_SECONDS=600

# incident state changes are disabled by default.
ENABLE_CASE_WRITES=false
CREATE_REVIEW_TASK=false
MARK_ACTIVE_ON_ESCALATION=false

# optional HTTPS receiver (e.g. email)
ESCALATION_WEBHOOK_URL=
AUDIT_DIR=audit
